PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/ocean.db
KRYPTOTRON_SUPABASE_URL=https://your-project.supabase.co
KRYPTOTRON_SUPABASE_KEY=your-server-side-key
# Vygenerujte: openssl rand -base64 32
OCEAN_CREDENTIALS_KEY=base64-encoded-32-byte-key
KRYPTOTRON_SUPERVISOR_ENABLED=false
KRYPTOTRON_PYTHON=python
APP_ORIGIN=http://localhost:3000
TRUST_PROXY=
BACKUP_DIRECTORY=./data/backups
BACKUP_RETENTION_DAYS=30
# Vygenerujte samostatně: openssl rand -base64 32
OCEAN_BACKUP_KEY=base64-encoded-32-byte-key
OCEAN_OFFSITE_BACKUP_ENABLED=false
OCEAN_OFFSITE_BACKUP_TIME=03:15
OCEAN_OFFSITE_BACKUP_TIME_ZONE=Europe/Prague
OCEAN_BACKUP_S3_ENDPOINT=https://account-id.r2.cloudflarestorage.com
OCEAN_BACKUP_S3_REGION=auto
OCEAN_BACKUP_S3_BUCKET=ocean-backups
OCEAN_BACKUP_S3_ACCESS_KEY_ID=
OCEAN_BACKUP_S3_SECRET_ACCESS_KEY=
OCEAN_BACKUP_S3_PREFIX=ocean
RESEND_API_KEY=
EMAIL_FROM=Ocean <ocean@example.com>
OCEAN_MANUAL_APPROVAL_ENABLED=false
OCEAN_TELEGRAM_BOT_TOKEN=
OCEAN_TELEGRAM_BOT_USERNAME=
NODE_ENV=development
